rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada documento vive en accesos/{email en minúsculas}.
    // Un alumno solo puede LEER su propio documento de acceso, y solo si
    // inició sesión con ese mismo correo en Firebase Auth.
    // Nadie puede escribir desde el cliente — solo las Cloud Functions
    // (que usan el Admin SDK y por lo tanto ignoran estas reglas) pueden
    // otorgar acceso, y solo después de confirmar un pago real con Stripe.
    match /accesos/{email} {
      allow read: if request.auth != null
                  && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Correos VIP (acceso completo sin pago). Un documento por correo VIP,
    // con el correo en minúsculas como ID (ej. vip_users/crisjus@hotmail.com).
    // Mismo patrón que accesos/{email}: cada quien solo puede leer si el
    // documento corresponde a su propio correo ya autenticado en Firebase
    // Auth — así el HTML público nunca vuelve a contener la lista de
    // correos VIP en texto plano. Nadie puede escribir desde el cliente;
    // los documentos se agregan a mano desde la Consola de Firebase.
    match /vip_users/{email} {
      allow read: if request.auth != null
                  && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Clave de respuestas correctas de los exámenes (módulos 2-6). Nadie
    // puede leerla ni escribirla desde el cliente, ni siquiera un alumno
    // con sesión iniciada — solo la Cloud Function "calificarExamen" la lee,
    // usando el Admin SDK (que ignora estas reglas). Así la clave nunca
    // viaja al navegador hasta que el alumno ya envió sus propias
    // respuestas y la función responde con el resultado.
    match /examenes_respuestas/{modulo} {
      allow read, write: if false;
    }

    // Contenido de la Guía y Actividades de cada módulo (2-6). Igual que la
    // clave de respuestas: nadie lo lee ni lo escribe desde el cliente, ni
    // siquiera un alumno con sesión iniciada. Solo la Cloud Function
    // "obtenerContenidoModulo" lo lee con el Admin SDK, y solo lo devuelve
    // si antes confirmó que ese correo tiene acceso real (VIP o compra en
    // la colección accesos) — así un `curl` a modulo3.html ya no obtiene
    // el texto de la guía.
    match /contenido_modulos/{modulo} {
      allow read, write: if false;
    }

    // Opiniones de alumnos (calificación + comentario libre) enviadas al
    // terminar el Módulo 6. Cualquiera puede CREAR una opinión (no hace
    // falta haber iniciado sesión con Firebase Auth aquí, el sitio ya
    // confía en el nombre/correo que trae de sessionStorage igual que en
    // el resto del curso) pero NADIE puede leer, editar ni borrar desde
    // el cliente — el dueño del sitio las revisa directamente en la
    // Consola de Firebase (Firestore Database), que usa credenciales de
    // administrador y por lo tanto ignora estas reglas.
    match /opiniones/{opinionId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.calificacion is int
                    && request.resource.data.calificacion >= 1
                    && request.resource.data.calificacion <= 5
                    && request.resource.data.comentario is string
                    && request.resource.data.comentario.size() <= 2000
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() <= 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200;
    }

    // Certificados verificables: un documento por certificado emitido, con
    // el UUID del certificado como ID del documento. Cualquiera puede leer
    // UN certificado por su ID exacto (así funciona la página pública
    // verificar.html), pero "list" está bloqueado para que no se puedan
    // extraer todos los nombres/correos de golpe. El sitio crea el
    // documento automáticamente al aprobar un examen; nadie puede editarlo
    // ni borrarlo después desde el cliente.
    match /certificados/{certId} {
      allow get: if true;
      allow list: if false;
      allow update, delete: if false;
      allow create: if request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.nombre.size() <= 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.modulo is int
                    && request.resource.data.modulo >= 1
                    && request.resource.data.modulo <= 6
                    && request.resource.data.moduloNombre is string
                    && request.resource.data.moduloNombre.size() <= 200
                    && request.resource.data.fecha is string
                    && request.resource.data.fecha.size() <= 100;
    }

    // Evidencia de consentimiento a Términos y Aviso de Privacidad, un
    // documento por correo (en minúsculas) como ID. Se crea UNA sola vez,
    // en el momento real del registro (correo/contraseña o primera vez con
    // Google) — el propio sitio nunca lo vuelve a escribir en logins
    // posteriores. Solo el dueño de ese correo, ya autenticado con ese
    // mismo correo en Firebase Auth, puede crear su propio documento (no
    // puede crear uno a nombre de otra persona); nadie puede leerlo,
    // editarlo ni borrarlo desde el cliente — es evidencia de solo lectura
    // para el dueño del sitio, revisable en la Consola de Firebase.
    match /consentimientos/{email} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
                    && request.auth.token.email.lower() == email
                    && request.resource.data.registrationMethod in ['password', 'google']
                    && request.resource.data.acceptedTermsVersion is string
                    && request.resource.data.acceptedTermsVersion.size() <= 20
                    && request.resource.data.acceptedPrivacyVersion is string
                    && request.resource.data.acceptedPrivacyVersion.size() <= 20
                    && request.resource.data.acceptedAt is timestamp;
    }
  }
}
